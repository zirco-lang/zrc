!3 = distinct !DISubprogram(name: "bar", linkageName: "bar", scope: null, file: !2, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !1)
!4 = !DISubroutineType(types: !5)
!5 = !{!6}
!6 = !DIBasicType(name: "i32")
!7 = !DILocation(line: 2, column: 9, scope: !8)
!8 = distinct !DILexicalBlock(scope: !9, file: !2, line: 1, column: 17)
!9 = distinct !DILexicalBlock(scope: !3, file: !2, line: 1, column: 17)
!10 = distinct !DISubprogram(name: "foo", linkageName: "foo", scope: null, file: !2, line: 5, type: !4, scopeLine: 5, spFlags: DISPFlagDefinition, unit: !1)
!11 = !DILocation(line: 6, column: 9, scope: !12)
