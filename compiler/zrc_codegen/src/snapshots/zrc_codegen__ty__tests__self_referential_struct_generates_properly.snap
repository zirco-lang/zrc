---
source: compiler/zrc_codegen/src/ty.rs
description: "// TEST: self-referential struct types should compile to LLVM IR\n// with pointers to empty structs as placeholders\nstruct Node {\n    value: i32,\n    next: *Node\n}\n\nstruct TreeNode {\n    value: i32,\n    left: *TreeNode,\n    right: *TreeNode\n}\n\nfn create_node(val: i32) -> *Node {\n    let node: *Node;\n    return node;\n}\n\nfn main() -> i32 {\n    let head: *Node;\n    let tree: TreeNode;\n    head = create_node(42);\n\n    return 0;\n}\n"
expression: resulting_ir
---
; ModuleID = 'test.zr'
source_filename = "test.zr"

define ptr @create_node(i32 %0) !dbg !3 {
entry:
  %let_node = alloca ptr, align 8, !dbg !10
  %arg_val = alloca i32, align 4, !dbg !10
  store i32 %0, ptr %arg_val, align 4, !dbg !10
    #dbg_declare(ptr %arg_val, !9, !DIExpression(), !12)
  %load = load ptr, ptr %let_node, align 8, !dbg !13
  ret ptr %load, !dbg !13
}

define i32 @main() !dbg !15 {
entry:
  %let_tree = alloca { i32, ptr, ptr }, align 8
  %let_head = alloca ptr, align 8
  %call = call ptr @create_node(i32 42), !dbg !18
  store ptr %call, ptr %let_head, align 8, !dbg !21
  ret i32 0, !dbg !22
}

!llvm.module.flags = !{!0}
!llvm.dbg.cu = !{!1}

!0 = !{i32 2, !"Debug Info Version", i32 3}
!1 = distinct !DICompileUnit(language: DW_LANG_C, file: !2, producer: "zrc test runner", isOptimized: false, flags: "zrc --fake-args", runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false)
!2 = !DIFile(filename: "test.zr", directory: "/fake/path")
!3 = distinct !DISubprogram(name: "create_node", linkageName: "create_node", scope: null, file: !2, line: 14, type: !4, scopeLine: 14, spFlags: DISPFlagDefinition, unit: !1, retainedNodes: !8)
!4 = !DISubroutineType(types: !5)
!5 = !{!6, !7}
!6 = !DIBasicType(name: "struct { value: i32, next: *struct {} }")
!7 = !DIBasicType(name: "i32")
!8 = !{!9}
!9 = !DILocalVariable(name: "val", scope: !3, file: !2, line: 14, type: !7)
!10 = !DILocation(line: 14, column: 35, scope: !11)
!11 = distinct !DILexicalBlock(scope: !3, file: !2, line: 14, column: 35)
!12 = !DILocation(line: 14, column: 16, scope: !11)
!13 = !DILocation(line: 16, column: 12, scope: !14)
!14 = distinct !DILexicalBlock(scope: !11, file: !2, line: 14, column: 35)
!15 = distinct !DISubprogram(name: "main", linkageName: "main", scope: null, file: !2, line: 19, type: !16, scopeLine: 19, spFlags: DISPFlagDefinition, unit: !1)
!16 = !DISubroutineType(types: !17)
!17 = !{!7}
!18 = !DILocation(line: 22, column: 24, scope: !19)
!19 = distinct !DILexicalBlock(scope: !20, file: !2, line: 19, column: 18)
!20 = distinct !DILexicalBlock(scope: !15, file: !2, line: 19, column: 18)
!21 = !DILocation(line: 22, column: 5, scope: !19)
!22 = !DILocation(line: 24, column: 12, scope: !19)
